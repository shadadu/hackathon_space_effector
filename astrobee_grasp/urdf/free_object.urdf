<robot name="free_object">
  <link name="object_link">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>

    <visual>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
      <material name="safety_orange">
        <color rgba="1.0 0.42 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
    </collision>
  </link>

  <gazebo reference="object_link">
    <material>Gazebo/Orange</material>
    <gravity>false</gravity>
  </gazebo>
</robot>
