<launch>
  <arg name="gui" default="false"/>
  <arg name="paused" default="false"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="object_x" default="0.50"/>
  <arg name="object_y" default="0.00"/>
  <arg name="object_z" default="0.25"/>
  <arg name="object_drift" default="true"/>
  <arg name="object_vx" default="-0.02"/>
  <arg name="object_vy" default="0.01"/>
  <arg name="object_vz" default="0.00"/>
  <arg name="object_bounce" default="false"/>
  <arg name="object_clamp_to_bounds" default="false"/>

  <!-- ===================== -->
  <!-- Gazebo                -->
  <!-- ===================== -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="gui" value="$(arg gui)"/>
  </include>

  <!-- Model XML consumed by gazebo_ros spawn_model below. -->
  <param name="object_description"
         textfile="$(find astrobee_grasp)/urdf/free_object.urdf"/>

  <!-- ===================== -->
  <!-- Spawn Free Object     -->
  <!-- ===================== -->
  <node pkg="gazebo_ros"
        type="spawn_model"
        name="spawn_object"
        args="-urdf -param object_description -model free_object -x $(arg object_x) -y $(arg object_y) -z $(arg object_z)"
        output="screen"/>

  <!-- ===================== -->
  <!-- Perception Stack      -->
  <!-- ===================== -->
  <include file="$(find astrobee_grasp)/launch/perception.launch">
    <arg name="object_x" value="$(arg object_x)"/>
    <arg name="object_y" value="$(arg object_y)"/>
    <arg name="object_z" value="$(arg object_z)"/>
    <arg name="object_drift" value="$(arg object_drift)"/>
    <arg name="object_vx" value="$(arg object_vx)"/>
    <arg name="object_vy" value="$(arg object_vy)"/>
    <arg name="object_vz" value="$(arg object_vz)"/>
    <arg name="object_bounce" value="$(arg object_bounce)"/>
    <arg name="object_clamp_to_bounds" value="$(arg object_clamp_to_bounds)"/>
  </include>

</launch>
