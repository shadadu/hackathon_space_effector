<launch>
  <arg name="gui" default="false"/>
  <arg name="paused" default="false"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="object_x" default="0.50"/>
  <arg name="object_y" default="0.00"/>
  <arg name="object_z" default="0.25"/>

  <!-- ===================== -->
  <!-- Gazebo                -->
  <!-- ===================== -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="gui" value="$(arg gui)"/>
  </include>

  <!-- Model XML consumed by gazebo_ros spawn_model below. -->
  <param name="object_description"
         textfile="$(find astrobee_grasp)/urdf/free_object.urdf"/>

  <!-- ===================== -->
  <!-- Spawn Free Object     -->
  <!-- ===================== -->
  <node pkg="gazebo_ros"
        type="spawn_model"
        name="spawn_object"
        args="-urdf -param object_description -model free_object -x $(arg object_x) -y $(arg object_y) -z $(arg object_z)"
        output="screen"/>

  <!-- ===================== -->
  <!-- Perception Stack      -->
  <!-- ===================== -->
  <include file="$(find astrobee_grasp)/launch/perception.launch"/>

</launch>
