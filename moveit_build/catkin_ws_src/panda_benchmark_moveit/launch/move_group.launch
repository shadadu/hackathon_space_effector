<launch>
  <!-- Frames -->
  <arg name="robot_name" default="panda"/>
  <arg name="use_sim_time" default="false"/>

  <!-- Planning pipeline -->
  <arg name="planning_pipeline" default="ompl"/>

  <param name="use_sim_time" value="$(arg use_sim_time)"/>

  <!-- Load robot_description (URDF) -->
  <!-- Prefer moveit_resources_panda_description if installed -->
  <param name="robot_description"
         command="$(find xacro)/xacro '$(find moveit_resources_panda_description)/urdf/panda.urdf.xacro'"/>

  <!-- Load SRDF -->
  <param name="robot_description_semantic"
         textfile="$(find moveit_resources_panda_moveit_config)/config/panda.srdf"/>

  <!-- Kinematics -->
  <rosparam command="load" file="$(find moveit_resources_panda_moveit_config)/config/kinematics.yaml"/>

  <!-- Joint limits -->
  <rosparam command="load" file="$(find moveit_resources_panda_moveit_config)/config/joint_limits.yaml"/>

  <!-- OMPL config -->
  <rosparam command="load" file="$(find moveit_resources_panda_moveit_config)/config/ompl_planning.yaml"/>

  <!-- MoveIt core params -->
  <param name="planning_pipelines" value="$(arg planning_pipeline)"/>

  <!-- Trajectory execution (fake controller for demo) -->
  <rosparam command="load" file="$(find moveit_resources_panda_moveit_config)/config/fake_controllers.yaml"/>
  <param name="moveit_controller_manager" value="moveit_fake_controller_manager/MoveItFakeControllerManager"/>

  <!-- Start move_group -->
  <node pkg="moveit_ros_move_group" type="move_group" name="move_group" output="screen">
    <!-- Ensure MoveIt loads OMPL -->
    <param name="planning_plugin" value="ompl_interface/OMPLPlanner"/>
    <param name="request_adapters" value="default_planner_request_adapters/AddTimeParameterization default_planner_request_adapters/FixWorkspaceBounds default_planner_request_adapters/FixStartStateBounds default_planner_request_adapters/FixStartStateCollision default_planner_request_adapters/FixStartStatePathConstraints"/>
    <param name="start_state_max_bounds_error" value="0.1"/>
  </node>
</launch>
