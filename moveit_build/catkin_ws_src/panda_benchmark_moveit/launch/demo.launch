<launch>
  <arg name="rviz" default="false"/>
  <arg name="use_sim_time" default="false"/>

  <!-- Start MoveIt server -->
  <include file="$(find panda_benchmark_moveit)/launch/move_group.launch">
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
  </include>



  <!-- DGM planner service endpoint -->
  <node pkg="object_tracking"
        type="dgm_planner_node.py"
        name="dgm_planner"
        output="screen">
    <param name="service_name" value="/dgm/get_motion_plan"/>
    <param name="group_name" value="panda_arm"/>
    <param name="ee_link" value="panda_hand"/>
    <param name="world_frame" value="world"/>

    <!-- Load DGM params (T, dt, R_diag, vel_limits, finetune settings, etc.) -->
    <rosparam file="$(find object_tracking)/config/dgm.yaml" command="load"/>

    <!-- checkpoint -->
    <param name="model_path" value="$(find object_tracking)/models/panda_dgm_v1.pt"/>
    <param name="device" value="cpu"/>

    <!-- (optional for future Jacobian hook; safe even if ignored by code) -->
    <param name="jacobian_service" value="/get_jacobian"/>
    <param name="use_jacobian_hook" value="false"/>
  </node>

  <!-- Dynamic object -> planning scene -->
  <node pkg="object_tracking"
        type="object_to_planning_scene.py"
        name="object_to_planning_scene"
        output="screen"/>

  <!-- Intercept planner (switch backend by changing plan_service) -->
  <node pkg="object_tracking" type="intercept_planner.py" name="intercept_planner" output="screen">
    <param name="object_topic" value="/object/state"/>
    <param name="world_frame" value="world"/>
    <param name="group_name" value="panda_arm"/>
    <param name="ee_link" value="panda_hand"/>

    <param name="ik_service" value="/compute_ik"/>
    <param name="plan_service" value="/plan_kinematic_path"/> <!-- or /dgm/get_motion_plan -->

    <param name="rate_hz" value="2.0"/>
    <param name="latency_s" value="0.15"/>
    <param name="t_min" value="0.2"/>
    <param name="t_max" value="2.0"/>
    <param name="t_step" value="0.1"/>

    <param name="grasp_offset_x" value="-0.12"/>
    <param name="grasp_offset_y" value="0.0"/>
    <param name="grasp_offset_z" value="0.0"/>
  </node>

  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="rviz" output="screen"
          args="-d $(find moveit_resources_panda_moveit_config)/launch/moveit.rviz"/>
  </group>
</launch>